### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# Runtime artifacts. These hold key material and chain position -- an enrollment
# file IS a host's K0, which forges that host's entire history. Never commit.
*.enroll.json
*.state.json
*.key
*.pem
/data
edr.wal*
